{"nodes": [{"id": "06_metadata_mimari_kararlar_mimari_kararlar", "label": "Mimari Kararlar", "file_type": "document", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Karar kaydi: bir seyi duzeltmeden once bakilmali, cogunun arkasinda bilincli gerekce var."}, {"id": "06_metadata_mimari_kararlar_sayfa_klasor_modeli", "label": "Sayfa = Kendi Klasoru + index.md", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sayfa tasinirken alt sayfalari ve gorselleri tek hamlede tasinsin diye; sayfayiYenidenAdlandir yalnizca klasoru moveItem ediyor."}, {"id": "06_metadata_mimari_kararlar_eski_duzen_destegi", "label": "Eski Duzen Destegi (Ad.md + Ad/)", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "agaciYukle() iki duzeni birden tarar, sayfayiKlasoreDonustur() goc ettirir. Kaldirilmiyor cunku kullanici verisi var."}, {"id": "06_metadata_mimari_kararlar_sabit_taban_punto", "label": "Sabit Taban Punto (kTabanPunto = 14)", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dosyaya yalnizca tabandan farkli puntolar <punto=..> ile yazilir; aksi halde her acilis/derlemede kaydedilen puntolar kayardi. gYaziBoyutu kalici degil, her acilista tabana doner."}, {"id": "06_metadata_mimari_kararlar_baslik_paragraf_ozniteligi", "label": "Baslik Paragraf Ozniteligi (kBaslikSeviyesiAnahtari)", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paragrafin baslik duzeyi oznitelikte tasinir, diske #/##/### olarak yazilir. Punto/kalin isareti gerekmez cunku baslik fontu seviyeden turetilir."}, {"id": "06_metadata_mimari_kararlar_egik_cizgi_komutlari", "label": "Egik Cizgi Komutlari (/1 /2 /3 /0 /page)", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "textView(_:shouldChangeTextIn:) icinde yakalanir ama duzenleme DispatchQueue.main.async ile sonraki donguye birakilir, cunku delegate geri cagrisinin icinde metin degistirmek AppKit'te tanimsiz davranistir."}, {"id": "06_metadata_mimari_kararlar_gorsel_kendi_satirinda", "label": "Gorsel Kendi Satirinda Durur", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ekiEkle() ekin onune/arkasina \\n koyar; ayni satiri metinle paylasirsa satir yuksekligi gorsel kadar olur ve yaninda kocaman bosluk olusur."}, {"id": "06_metadata_mimari_kararlar_sigdirma_saklanan_boyut", "label": "Sigdirma Saklanan Boyutu Degistirmez", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cellFrame(for:) gorseli satira sigdirir ama gosterimBoyutu sabit kalir, boylece pencere genisleyince gorsel eski boyutuna doner."}, {"id": "06_metadata_mimari_kararlar_gorsel_adi_bolum_basligindan", "label": "Gorsel Adi Bolum Basligindan Uretilir", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bulunanBolumBasligi() imlecten yukari dogru en yakin basligi bulur; dosya Baslik1.png, ikincisi Baslik1-2.png olur."}, {"id": "06_metadata_mimari_kararlar_tek_atimlik_timer", "label": "Otomatik Kayit: Tek Atimlik Timer", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "icerikDegisti() 5 sn'lik tek atimlik timer kurar, zaten varsa yenisini acmaz. Kesintisiz yazarken en fazla 5 sn'de bir disk yazimi, bostayken hic timer donmez (enerji dostu); tolerance = 1 ile sistem uyandirmalari birlestirilebilir."}, {"id": "06_metadata_mimari_kararlar_otomatik_kayitta_panel_yenilenmez", "label": "Otomatik Kayitta Panel Yenilenmez", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kaydetURLe(..., panelYenile: false) cunku KenarPaneli.yenile() tum notlarin icerigini diskten okur (arama onbellegi) ve bunu her 5 saniyede bir yapmak pahalidir."}, {"id": "06_metadata_mimari_kararlar_ayni_icerigi_tekrar_yazmama", "label": "Ayni Icerigi Tekrar Yazmama", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kaydetURLe() sonYazilanIcerik ile karsilastirip degismemisse diske yazmiyor."}, {"id": "06_metadata_mimari_kararlar_gecmisi_sifirla", "label": "Not Degistirirken Gecmis Sifirlanir", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gecmisiSifirla() notuAc() icinde cagrilir; yoksa Cmd+Z onceki notun icerigini su ankinin uzerine geri getirir."}, {"id": "06_metadata_mimari_kararlar_turkce_normallestirme", "label": "Turkce Duyarli Normallestirme", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "folding(options: [.diacriticInsensitive, .caseInsensitive], locale: tr_TR) kullaniliyor ki I/i/\u0131 ve o u s c g dogru eslessin; locale verilmezse Turkce nokta-i sorunlari cikar."}, {"id": "06_metadata_mimari_kararlar_punto_kisayollari", "label": "Punto Kisayollari Menuden Gecmiyor", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "performKeyEquivalent() *, +, =, -, _ tuslarini shift'i yok sayarak yakalar, cunku Turkce Q klavyede * shift'siz, ABD duzeninde shift'li uretilir ve menu keyEquivalent eslesmesi duzene gore kaciyor."}, {"id": "06_metadata_mimari_kararlar_tam_ekran_iki_yol", "label": "Tam Ekran Iki Yoldan", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yesil buton gizli ama collectionBehavior'a .fullScreenPrimary eklendigi icin toggleFullScreen calisiyor (Fn+F veya Ctrl+Cmd+F)."}, {"id": "06_metadata_mimari_kararlar_ozel_baslik_cubugu", "label": "Ozel Baslik Cubugu", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standart pencere dugmeleri gizlenip BaslikCubugu kendi dugmelerini ciziyor; suruklemede mouseDown -> performDrag(with:) kullaniliyor."}, {"id": "06_metadata_mimari_kararlar_secim_vurgusu", "label": "Secim Vurgusu Elle Ciziliyor", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NotSatirGorunumu.drawSelection() bos birakilip animasyonlu vurguGorunumu katmani kullaniliyor, cunku varsayilan mavi secim kagit temalariyla uyumsuz."}, {"id": "06_metadata_mimari_kararlar_kalici_durum", "label": "Kalici Durum (UserDefaults)", "file_type": "concept", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "temaIndex, kenarPanelGenislik, kenarPanelGizli, sonNotYolu, acikKlasorler anahtarlariyla oturumlar arasi durum korunuyor."}, {"id": "06_metadata_mimari_kararlar_artimli_onbellek", "label": "Artimli Arama Onbellegi", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "icerikOnbelleginiTazele() degismemis notu yeniden okumaz (mtime karsilastirmasi). Asil maliyet onbellekte degil: 1000 notta yenile()in %72'si agac taramasinda geciyor."}, {"id": "06_metadata_mimari_kararlar_resourcevalues_tuzagi", "label": "URL.resourceValues Onbellek Tuzagi", "file_type": "rationale", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URL.resourceValues degerleri ornek basina onbelleklenir; ayni URL ornegi yeniden sorgulanirsa dosya degisse bile eski deger doner. Her olcumde taze URL kurulmali; agaciYukle() zaten boyle calisiyor."}, {"id": "sources_notdefteri_pencere_notpenceresi_pencere_performkeyequivalent", "label": "performKeyEquivalent()", "file_type": "code", "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "06_metadata_mimari_kararlar_mimari_kararlar", "target": "06_metadata_mimari_kararlar_sayfa_klasor_modeli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "06_Metadata/Mimari-Kararlar.md", "source_location": null, "weight": 1.0}, {"source": "06_metadata_mimari_karar